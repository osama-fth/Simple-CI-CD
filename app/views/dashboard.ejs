<%- include('partials/head') %>
<body>
  <div class="app-shell">
    <%- include('partials/sidebar') %>

    <main class="app-main-content">
      <div class="app-content-body">
        <header class="section-header d-flex justify-content-between align-items-center">
          <div>
            <h1 class="section-title">Panoramica Archivio</h1>
            <p class="section-subtitle">Stato operativo delle copie, movimenti e utenza</p>
          </div>
          <div class="d-flex gap-2">
            <a href="/prestiti" class="btn btn-primary btn-sm d-flex align-items-center gap-1">
              <i class="bi bi-plus-circle"></i>
              <span>Nuovo Prestito</span>
            </a>
          </div>
        </header>

        <%- include('partials/alerts') %>

        <!-- Metriche Operative -->
        <div class="row g-3 mb-4">
          <div class="col-xl-3 col-sm-6">
            <div class="stat-card">
              <div class="stat-label">Titoli a Catalogo</div>
              <div class="stat-value"><%= stats.totaleTitoli %></div>
              <div class="mt-2 text-muted small"><i class="bi bi-journal-text me-1"></i>Opere uniche</div>
            </div>
          </div>

          <div class="col-xl-3 col-sm-6">
            <div class="stat-card">
              <div class="stat-label">Copie Disponibili</div>
              <div class="stat-value text-success"><%= stats.copieDisponibili %> <span class="fs-6 fw-normal text-muted">/ <%= stats.totaleCopie %></span></div>
              <div class="mt-2 text-muted small"><i class="bi bi-bookshelf me-1"></i>Pronte per il prestito</div>
            </div>
          </div>

          <div class="col-xl-3 col-sm-6">
            <div class="stat-card">
              <div class="stat-label">Prestiti in Corso</div>
              <div class="stat-value text-primary"><%= stats.prestitiAttivi %></div>
              <div class="mt-2 text-muted small"><i class="bi bi-arrow-left-right me-1"></i>Volumi attualmente fuori</div>
            </div>
          </div>

          <div class="col-xl-3 col-sm-6">
            <div class="stat-card">
              <div class="stat-label">Prestiti in Ritardo</div>
              <div class="stat-value <%= stats.prestitiInRitardo > 0 ? 'text-danger' : 'text-muted' %>">
                <%= stats.prestitiInRitardo %>
              </div>
              <div class="mt-2 small <%= stats.prestitiInRitardo > 0 ? 'text-danger' : 'text-muted' %>">
                <i class="bi bi-exclamation-triangle me-1"></i>Scadenza superata
              </div>
            </div>
          </div>
        </div>

        <!-- Registro Ultime Attività -->
        <div class="panel-card">
          <div class="panel-toolbar d-flex justify-content-between align-items-center">
            <span class="fw-semibold small text-secondary">Ultime movimentazioni registrate</span>
            <a href="/prestiti" class="small text-decoration-none">Vedi tutti i prestiti &rarr;</a>
          </div>

          <div class="table-responsive">
            <table class="table table-data">
              <thead>
                <tr>
                  <th>#</th>
                  <th>Data</th>
                  <th>Tesserato</th>
                  <th>Inventario</th>
                  <th>Titolo Opera</th>
                  <th>Stato Movimento</th>
                </tr>
              </thead>
              <tbody>
                <% if (stats.ultimeAttivita && stats.ultimeAttivita.length) { %>
                  <% stats.ultimeAttivita.forEach(m => { %>
                    <tr>
                      <td><code class="mono-code">#<%= m.id_prestito %></code></td>
                      <td><%= new Date(m.data_prestito).toLocaleDateString('it-IT') %></td>
                      <td class="fw-medium"><%= m.nome %> <%= m.cognome %></td>
                      <td><code class="mono-code"><%= m.codice_inventario %></code></td>
                      <td><%= m.titolo %></td>
                      <td>
                        <% if (m.stato === 'Attivo') { %>
                          <span class="status-badge loaned"><i class="bi bi-hourglass-split"></i> In corso</span>
                        <% } else { %>
                          <span class="status-badge available"><i class="bi bi-check-lg"></i> Restituito</span>
                        <% } %>
                      </td>
                    </tr>
                  <% }) %>
                <% } else { %>
                  <tr>
                    <td colspan="6" class="text-center py-4 text-muted small">Nessuna movimentazione recente registrata a sistema.</td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>

      </div>
    </main>
  </div>
<%- include('partials/footer') %>
