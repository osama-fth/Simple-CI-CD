<aside class="app-sidebar d-flex flex-column flex-shrink-0 p-3 text-white">
  <!-- Brand Header -->
  <div class="sidebar-brand d-flex align-items-center gap-2 pb-3 mb-3 border-bottom border-secondary-subtle">
    <i class="bi bi-book-half fs-4 text-primary-emphasis"></i>
    <div>
      <span class="fs-6 fw-semibold d-block text-white leading-tight">Sistema Bibliotecario</span>
      <span class="small text-secondary">Archivio & Prestiti</span>
    </div>
  </div>

  <!-- Navigazione Principale -->
  <ul class="nav nav-pills flex-column mb-auto gap-1">
    <li class="nav-item">
      <a href="/" class="nav-link d-flex align-items-center gap-2 <%= activePage === 'dashboard' ? 'active' : 'text-white-50' %>">
        <i class="bi bi-grid-1x2"></i>
        <span>Dashboard</span>
      </a>
    </li>
    <li class="nav-item">
      <a href="/libri" class="nav-link d-flex align-items-center gap-2 <%= activePage === 'libri' ? 'active' : 'text-white-50' %>">
        <i class="bi bi-bookshelf"></i>
        <span>Catalogo Libri</span>
      </a>
    </li>
    <li class="nav-item">
      <a href="/prestiti" class="nav-link d-flex align-items-center gap-2 <%= activePage === 'prestiti' ? 'active' : 'text-white-50' %>">
        <i class="bi bi-arrow-left-right"></i>
        <span>Prestiti & Rientri</span>
      </a>
    </li>
    <li class="nav-item">
      <a href="/tesserati" class="nav-link d-flex align-items-center gap-2 <%= activePage === 'tesserati' ? 'active' : 'text-white-50' %>">
        <i class="bi bi-people"></i>
        <span>Anagrafica Tesserati</span>
      </a>
    </li>
  </ul>

  <!-- Profilo Operatore & Logout -->
  <div class="sidebar-footer pt-3 mt-3 border-top border-secondary-subtle">
    <div class="d-flex align-items-center justify-content-between">
      <div class="d-flex align-items-center gap-2 overflow-hidden">
        <div class="operator-avatar text-center flex-shrink-0">
          <i class="bi bi-person-badge"></i>
        </div>
        <div class="text-truncate">
          <div class="small fw-semibold text-white text-truncate"><%= currentUser ? currentUser.nome : 'Operatore' %></div>
          <div class="extra-small text-secondary text-truncate"><%= currentUser ? currentUser.ruolo : 'Operatore' %></div>
        </div>
      </div>
      <form action="/logout" method="POST" class="m-0 flex-shrink-0">
        <button type="submit" class="btn btn-outline-secondary btn-sm px-2 py-1 text-white-50 hover-white" title="Disconnetti sessione">
          <i class="bi bi-box-arrow-right"></i>
        </button>
      </form>
    </div>
  </div>
</aside>
