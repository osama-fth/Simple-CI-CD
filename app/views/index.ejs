<!DOCTYPE html>
<html lang="it">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>
    <%= title %>
  </title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
    integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
    integrity="sha384-XGjxtQfXaH2tnPFa9x+ruJTuLE3Aa6LhHSWRr1XeTyhezb4abCG4ccI5AkVDxqC+" crossorigin="anonymous" />
  <link rel="stylesheet" href="/stylesheets/style.css" />
  <link rel="icon" href="data:,">
</head>

<body class="app-layout">
  <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm py-2">
    <div class="container">
      <a class="navbar-brand fw-semibold d-flex align-items-center gap-2" href="/">
        <i class="bi bi-book-half text-warning"></i>
        <%= title %>
      </a>
      <div class="navbar-nav ms-auto">
        <span class="nav-link text-light small">
          <i class="bi bi-database me-1"></i>PostgreSQL
        </span>
      </div>
    </div>
  </nav>

  <main class="container py-5">
    <div class="row justify-content-center">
      <div class="col-xl-11 col-lg-12">

        <header class="text-center mb-4">
          <div class="d-flex justify-content-center align-items-center gap-2 mb-2">
            <i class="bi bi-journal-bookmark text-primary fs-4"></i>
            <h1 class="h3 fw-semibold mb-0 page-title"><%= title %></h1>
          </div>
          <p class="text-muted mb-0">
            <i class="bi bi-gear me-1"></i>Demo gestionale Biblioteca (Libri, Prestiti, Ritardi)
          </p>
        </header>

        <% if (typeof error !== 'undefined' && error) { %>
          <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-2 mb-4" role="alert">
            <i class="bi bi-exclamation-octagon-fill"></i>
            <div><%= error %></div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
          </div>
        <% } %>
        <% if (typeof success !== 'undefined' && success) { %>
          <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2 mb-4" role="alert">
            <i class="bi bi-check-circle-fill"></i>
            <div><%= success %></div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
          </div>
        <% } %>

        <!-- Form Nuovo Prestito -->
        <section class="card shadow-soft border-0 overflow-hidden mb-4">
          <div class="card-header d-flex justify-content-between align-items-center py-3">
            <div class="d-flex align-items-center gap-2">
              <i class="bi bi-plus-circle text-success"></i>
              <span class="fw-semibold">Nuovo Prestito</span>
            </div>
            <button class="btn btn-primary btn-sm d-flex align-items-center gap-1" data-bs-toggle="collapse"
              data-bs-target="#newLoan" aria-expanded="false" aria-controls="newLoan">
              <i class="bi bi-box-arrow-in-down-right"></i>
              <span class="d-none d-sm-inline">Apri</span>
            </button>
          </div>

          <div class="collapse" id="newLoan">
            <div class="card-body bg-light border-bottom">
              <form class="row g-2" action="/prestiti" method="POST">
                <div class="col-md-4">
                  <div class="input-group input-group-sm">
                    <span class="input-group-text"><i class="bi bi-upc-scan"></i></span>
                    <input required name="codice_inventario" class="form-control" maxlength="30" placeholder="Codice inventario (es. C1001)" />
                  </div>
                </div>
                <div class="col-md-4">
                  <div class="input-group input-group-sm">
                    <span class="input-group-text"><i class="bi bi-person-vcard"></i></span>
                    <input required name="codice_fiscale" class="form-control" pattern="[A-Za-z0-9]{16}" maxlength="16" title="Codice Fiscale di 16 caratteri alfanumerici" placeholder="CF tesserato (16 caratteri)" />
                  </div>
                </div>
                <div class="col-md-3">
                  <div class="input-group input-group-sm">
                    <span class="input-group-text"><i class="bi bi-calendar-date"></i></span>
                    <input required name="data_restituzione_prevista" type="date" class="form-control" />
                  </div>
                </div>
                <div class="col-md-1">
                  <button type="submit" class="btn btn-success btn-sm w-100">
                    <i class="bi bi-check-lg"></i>
                  </button>
                </div>
              </form>
              <small class="text-muted">Suggerimento: usa un codice inventario disponibile dalla tabella sotto.</small>
            </div>
          </div>
        </section>

        <!-- Libri disponibili -->
        <section class="card shadow-soft border-0 overflow-hidden mb-4">
          <div class="card-header d-flex justify-content-between align-items-center py-3">
            <div class="d-flex align-items-center gap-2">
              <i class="bi bi-bookshelf text-primary"></i>
              <span class="fw-semibold">Libri disponibili</span>
              <% if (libri && libri.length) { %>
                <span class="badge bg-primary-subtle text-primary"><%= libri.length %> copie</span>
              <% } %>
            </div>
          </div>
          <div class="card-body p-0">
            <% if (libri && libri.length) { %>
              <div class="table-responsive">
                <table class="table table-hover table-sm align-middle mb-0 table-modern">
                  <thead>
                    <tr>
                      <th>Inventario</th>
                      <th>ISBN</th>
                      <th>Titolo</th>
                      <th>Genere</th>
                      <th>Età</th>
                      <th>Editore</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% libri.forEach(b => { %>
                      <tr>
                        <td><code class="id-badge"><%= b.codice_inventario %></code></td>
                        <td><%= b.isbn %></td>
                        <td class="fw-medium"><%= b.titolo %></td>
                        <td><%= b.nome_genere %></td>
                        <td><%= b.categoria_eta %></td>
                        <td><%= b.nome_editore %></td>
                      </tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>
            <% } else { %>
              <div class="p-4 text-center text-muted">Nessuna copia disponibile</div>
            <% } %>
          </div>
        </section>

        <!-- Prestiti attivi -->
        <section class="card shadow-soft border-0 overflow-hidden mb-4">
          <div class="card-header d-flex justify-content-between align-items-center py-3">
            <div class="d-flex align-items-center gap-2">
              <i class="bi bi-arrow-left-right text-warning"></i>
              <span class="fw-semibold">Prestiti attivi</span>
              <% if (prestitiAttivi && prestitiAttivi.length) { %>
                <span class="badge bg-warning-subtle text-warning"><%= prestitiAttivi.length %></span>
              <% } %>
            </div>
          </div>
          <div class="card-body p-0">
            <% if (prestitiAttivi && prestitiAttivi.length) { %>
              <div class="table-responsive">
                <table class="table table-hover table-sm align-middle mb-0 table-modern">
                  <thead>
                    <tr>
                      <th>#</th>
                      <th>Tesserato</th>
                      <th>Inventario</th>
                      <th>Titolo</th>
                      <th>Data prestito</th>
                      <th>Restituzione prevista</th>
                      <th>Azioni</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% prestitiAttivi.forEach(p => { %>
                      <tr>
                        <td><code class="id-badge"><%= p.id_prestito %></code></td>
                        <td><%= p.nome %> <%= p.cognome %> <small class="text-muted">(<%= p.codice_fiscale_mascherato || p.codice_fiscale %>)</small></td>
                        <td><code class="id-badge"><%= p.codice_inventario %></code></td>
                        <td class="fw-medium"><%= p.titolo %></td>
                        <td><%= new Date(p.data_prestito).toLocaleDateString('it-IT') %></td>
                        <td><%= new Date(p.data_restituzione_prevista).toLocaleDateString('it-IT') %></td>
                        <td>
                          <form action="/prestiti/<%= p.id_prestito %>/restituisci" method="POST"
                                onsubmit="return confirm('Registrare la restituzione del prestito #<%= p.id_prestito %>?')"
                                class="d-inline">
                            <button type="submit" class="btn btn-outline-success btn-sm px-2 py-1" title="Restituisci">
                              <i class="bi bi-arrow-return-left"></i>
                            </button>
                          </form>
                        </td>
                      </tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>
            <% } else { %>
              <div class="p-4 text-center text-muted">Nessun prestito attivo</div>
            <% } %>
          </div>
        </section>

        <!-- Prestiti in ritardo -->
        <section class="card shadow-soft border-0 overflow-hidden mb-2">
          <div class="card-header d-flex justify-content-between align-items-center py-3">
            <div class="d-flex align-items-center gap-2">
              <i class="bi bi-exclamation-triangle text-danger"></i>
              <span class="fw-semibold">Prestiti in ritardo</span>
              <% if (prestitiInRitardo && prestitiInRitardo.length) { %>
                <span class="badge bg-danger-subtle text-danger"><%= prestitiInRitardo.length %></span>
              <% } %>
            </div>
          </div>
          <div class="card-body p-0">
            <% if (prestitiInRitardo && prestitiInRitardo.length) { %>
              <div class="table-responsive">
                <table class="table table-hover table-sm align-middle mb-0 table-modern">
                  <thead>
                    <tr>
                      <th>#</th>
                      <th>Tesserato</th>
                      <th>Inventario</th>
                      <th>Titolo</th>
                      <th>Data prestito</th>
                      <th>Restituzione prevista</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% prestitiInRitardo.forEach(p => { %>
                      <tr class="table-danger">
                        <td><code class="id-badge"><%= p.id_prestito %></code></td>
                        <td><%= p.nome %> <%= p.cognome %> <small class="text-muted">(<%= p.codice_fiscale_mascherato || p.codice_fiscale %>)</small></td>
                        <td><code class="id-badge"><%= p.codice_inventario %></code></td>
                        <td class="fw-medium"><%= p.titolo %></td>
                        <td><%= new Date(p.data_prestito).toLocaleDateString('it-IT') %></td>
                        <td><%= new Date(p.data_restituzione_prevista).toLocaleDateString('it-IT') %></td>
                      </tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>
            <% } else { %>
              <div class="p-4 text-center text-muted">Nessun ritardo</div>
            <% } %>
          </div>
        </section>

        <footer class="text-center py-3">
          <div class="d-flex justify-content-center align-items-center gap-3 text-muted small">
            <span class="d-flex align-items-center gap-1"><i class="bi bi-code-slash"></i>Demo DevSecOps</span>
            <span class="d-flex align-items-center gap-1"><i class="bi bi-layers"></i><span class="stack-ref">Express + PostgreSQL</span></span>
            <span class="d-flex align-items-center gap-1"><i class="bi bi-github"></i>CI/CD Pipeline</span>
          </div>
        </footer>

      </div>
    </div>
  </main>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
    integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
</body>
</html>
