<%- include('partials/head') %>
<body class="login-shell">
  <main class="login-card">
    <div class="login-card-header">
      <div class="d-inline-flex align-items-center justify-content-center p-2 rounded bg-primary-subtle text-primary mb-2">
        <i class="bi bi-book-half fs-3"></i>
      </div>
      <h1 class="h5 fw-semibold mb-1 text-dark">Gestionale Biblioteca</h1>
      <p class="small text-muted mb-0">Portale di servizio per operatori accreditati</p>
    </div>

    <div class="login-card-body">
      <%- include('partials/alerts') %>

      <form action="/login" method="POST">
        <div class="mb-3">
          <label for="username" class="form-label">Identificativo operatore</label>
          <div class="input-group input-group-sm">
            <span class="input-group-text bg-light"><i class="bi bi-person"></i></span>
            <input
              type="text"
              class="form-control"
              id="username"
              name="username"
              required
              autofocus
              autocomplete="username"
              placeholder="Nome utente"
            />
          </div>
        </div>

        <div class="mb-4">
          <label for="password" class="form-label">Password di servizio</label>
          <div class="input-group input-group-sm">
            <span class="input-group-text bg-light"><i class="bi bi-key"></i></span>
            <input
              type="password"
              class="form-control"
              id="password"
              name="password"
              required
              autocomplete="current-password"
              placeholder="Password"
            />
          </div>
        </div>

        <button type="submit" class="btn btn-primary w-100 btn-sm py-2 fw-medium">
          Accedi al sistema
        </button>
      </form>

      <div class="mt-4 pt-3 border-top text-center">
        <small class="text-muted extra-small">
          Accesso riservato al personale della biblioteca. Tutte le sessioni sono tracciate.
        </small>
      </div>
    </div>
  </main>
<%- include('partials/footer') %>
